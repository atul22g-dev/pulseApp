# PULSE — environment variables (copy to `.env` and fill in)

# Atual API (https://apis-atual-dev.vercel.app) — optional playlist-sync backend.
# When set, the app fetches playlists from GET /api/playlists with this key
# (sent as the `X-API-Key` header) instead of YouTube's public feed.
EXPO_PUBLIC_ATUAL_API_KEY=

# YouTube Data API v3 — optional alternative to the public feed.
# Full pagination + real durations, but the feed path works without any key.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# CORS relay for the web build only. YouTube's feed sends no CORS headers, so
# the browser reads it through a proxy. A URL template containing `{url}` — the
# encoded feed URL is substituted in. Comma-separated list = tried in order
# (custom relays first, built-in defaults as a last resort). Native builds
# never use this.
#   EXPO_PUBLIC_FEED_PROXY=https://my-relay.example.com/?url={url}
EXPO_PUBLIC_FEED_PROXY=

# Build timestamp shown in Settings → "App & build info" → "Built at".
# It's inlined at bundle time, so set it fresh for each build, e.g.:
#   EXPO_PUBLIC_BUILD_TIME=$(date +%s%3N)   (ms epoch — the app formats it)
# Optional — the card works without it (it always shows "Bundle loaded").
EXPO_PUBLIC_BUILD_TIME=
